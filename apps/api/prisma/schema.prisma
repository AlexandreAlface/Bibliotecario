// prisma/schema.prisma (atualizado) — adiciona relação Livro↔Biblioteca via LibraryBook

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ConsultationStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

enum SlotStatus {
  OPEN // visível para marcação
  BOOKED // reservado/associado a uma consulta
  BLOCKED // bloqueado pelo bibliotecário (férias, reunião, etc.)
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ProposalActor {
  FAMILY
  LIBRARIAN
  SYSTEM
}

// Tabela de perfis de utilizador
model Role {
  id        Int        @id @default(autoincrement()) // PK: id_role
  name      String     @unique // nome do perfil (ex.: “FAMÍLIA”, “BIBLIOTECÁRIO”, “CRIANÇA”)
  userRoles UserRole[] // relação N:N → UserRole
}

// Tabela de utilizadores (família, bibliotecário, criança, administrador)
model User {
  id           Int     @id @default(autoincrement())
  fullName     String
  email        String  @unique
  phone        String?
  citizenCard  String?
  address      String?
  postalCode   String?
  passwordHash String

  userRoles         UserRole[]
  userLibraries     UserLibrary[]
  children          ChildFamily[]
  ratings           Rating[]
  pointsHistory     PointsHistory[]
  eventReservations EventReservation[]

  consultationsAsFamily    Consultation[] @relation("ConsultationsAsFamily")
  consultationsAsLibrarian Consultation[] @relation("ConsultationsAsLibrarian")

  // 👇 novos lados opostos
  consultationSlots            ConsultationSlot[]     @relation("LibrarianSlots")
  consultationEventsAuthored   ConsultationEvent[]    @relation("ConsultationEventActor")
  consultationProposalsDecided ConsultationProposal[] @relation("ProposalDecider")

  newsletterSubscriptions NewsletterSubscription[]
  microInteractions       MicroInteraction[]
}

// Associação N:N entre User e Role
model UserRole {
  user   User @relation(fields: [userId], references: [id])
  userId Int // FK → User.id
  role   Role @relation(fields: [roleId], references: [id])
  roleId Int // FK → Role.id

  @@id([userId, roleId]) // PK composto
}

// Tabela de bibliotecas
model Library {
  id      Int     @id @default(autoincrement())
  name    String
  address String?
  contact String?

  userLibraries UserLibrary[]
  feeds         FeedRss[]

  // 👇 novos lados opostos
  consultations     Consultation[]
  consultationSlots ConsultationSlot[]

  CulturalEvent CulturalEvent[]

  // 👇 NOVO: relação para holdings (exemplares) por biblioteca
  libraryBooks LibraryBook[]
}

// Associação N:N entre User e Library
model UserLibrary {
  user      User    @relation(fields: [userId], references: [id])
  userId    Int // FK → User.id
  library   Library @relation(fields: [libraryId], references: [id])
  libraryId Int // FK → Library.id

  @@id([userId, libraryId]) // PK composto
}

// Configuração de feeds RSS por biblioteca
model FeedRss {
  id            Int       @id @default(autoincrement()) // PK: id_feed
  library       Library   @relation(fields: [libraryId], references: [id])
  libraryId     Int // FK → Library.id
  url           String // url_feed
  lastBuildDate DateTime? // última data de atualização
  ttl           Int? // tempo de validade (minutos)

  events CulturalEvent[] // relação 1:N → CulturalEvent
}

// Definição de fontes CSV para catálogo de livros
model CsvSource {
  id         Int      @id @default(autoincrement()) // PK: id_csv
  name       String   @unique // nome_fonte
  filePath   String // path_ficheiro ou URL
  importDate DateTime // data_import
}

// Catálogo de livros
model Book {
  isbn            String  @id // ISBN
  title           String // título
  summary         String? // “Resumo” do livro
  author          String // Autor_Beja
  publicationYear Int? // ano (extraído de Publicacao_Beja)
  collection      String? // Colecao_Beja
  category        String? // Assuntos_Beja
  cdu             String? // CDU_Beja
  ageRange        String? // faixa etária
  coverUrl        String? // URL da capa

  ageMin    Int?
  ageMax    Int?
  genres    String[]                     @default([]) // opcional (p/ futuro); mantém category como está
  embedding Unsupported("vector(1536)")?

  origins          BookOrigin[] // ligações às origens
  readings         Reading[]
  ratings          Rating[]
  bookReservations BookReservation[]

  // 👇 NOVO: holdings por biblioteca
  libraries LibraryBook[]
}

// Tabela de origens de cada livro (PNL, CSV, API externa…)
model Origin {
  id          Int    @id @default(autoincrement()) // PK: id_origem
  description String @unique // descrição da origem

  books BookOrigin[] // relação N:N → BookOrigin
}

// Associação N:N entre Book e Origin
model BookOrigin {
  book     Book   @relation(fields: [bookIsbn], references: [isbn])
  bookIsbn String // FK → Book.isbn
  origin   Origin @relation(fields: [originId], references: [id])
  originId Int // FK → Origin.id

  @@id([bookIsbn, originId]) // PK composto
}

// Dados de crianças para perfil de leitor
model Child {
  id            Int      @id @default(autoincrement())
  name          String
  birthDate     DateTime
  gender        String?
  readerProfile String?

  families         ChildFamily[]
  readings         Reading[]
  badgeAssignments BadgeAssignment[]
  ChildPreference  ChildPreference?
  bookReservations BookReservation[]

  ratings Rating[]

  // 👇 novo lado oposto
  consultations Consultation[]
}

model ChildPreference {
  childId     Int                          @unique
  profileText String?
  embedding   Unsupported("vector(1536)")?
  updatedAt   DateTime                     @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
}

// Associação N:N entre Child e User (família)
model ChildFamily {
  child    Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId  Int // FK → Child.id
  family   User  @relation(fields: [familyId], references: [id])
  familyId Int // FK → User.id (role = FAMÍLIA)

  @@id([childId, familyId]) // PK composto
}

// -------------------- Reading --------------------
model Reading {
  id            Int              @id @default(autoincrement())
  child         Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId       Int
  book          Book             @relation(fields: [bookIsbn], references: [isbn])
  bookIsbn      String
  startedAt     DateTime?
  finishedAt    DateTime?
  reservation   BookReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  reservationId Int?
  ratings       Rating[]

  @@unique([childId, bookIsbn]) // 👈 APENAS UMA leitura por (criança, livro)
  @@index([childId, finishedAt])
  @@index([childId, bookIsbn, finishedAt])
}

model Rating {
  id      Int    @id @default(autoincrement())
  user    User   @relation(fields: [userId], references: [id]) // quem registou
  userId  Int
  // 👇 para que criança vale a avaliação (opcional)
  child   Child? @relation(fields: [childId], references: [id], onDelete: SetNull)
  childId Int?

  book     Book   @relation(fields: [bookIsbn], references: [isbn])
  bookIsbn String

  // 👇 opcional: liga à sessão de leitura
  reading   Reading? @relation(fields: [readingId], references: [id], onDelete: SetNull)
  readingId Int?

  stars   Int
  comment String?
  ratedAt DateTime @default(now())

  @@unique([userId, childId, bookIsbn])
  @@index([childId])
  @@index([bookIsbn])
}

// Definição de selos e troféus
model Badge {
  id       Int    @id @default(autoincrement()) // PK: id_badge
  name     String @unique // nome do selo/troféu
  type     String // tipo (“SELLO”/“TROFÉU”)
  criteria String // critério de atribuição

  assignments BadgeAssignment[] // relação 1:N → BadgeAssignment
}

// Associação entre Badge e Child
model BadgeAssignment {
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId    Int // FK → Child.id
  badge      Badge    @relation(fields: [badgeId], references: [id])
  badgeId    Int // FK → Badge.id
  assignedAt DateTime @default(now()) // data_atribuicao

  @@id([childId, badgeId]) // PK composto
}

// Histórico de pontos por ação (LER, AVALIAR, RESERVAR…)
model PointsHistory {
  id         Int      @id @default(autoincrement()) // PK: id_ponto
  user       User     @relation(fields: [userId], references: [id])
  userId     Int // FK → User.id
  action     String // ação (ex.: “LER”, “EVENTO”)
  points     Float // pontos ganhos
  actionDate DateTime @default(now()) // data_acao
}

model Consultation {
  id Int @id @default(autoincrement())

  family   User @relation("ConsultationsAsFamily", fields: [familyId], references: [id])
  familyId Int

  librarian   User @relation("ConsultationsAsLibrarian", fields: [librarianId], references: [id])
  librarianId Int

  child   Child? @relation(fields: [childId], references: [id], onDelete: SetNull)
  childId Int?

  library   Library? @relation(fields: [libraryId], references: [id])
  libraryId Int?
  mode      String?
  location  String?

  requestedAt DateTime           @default(now())
  startAt     DateTime?
  endAt       DateTime?
  status      ConsultationStatus @default(PENDING)

  notes String?

  // 👇 1–1: FK aqui + UNIQUE, e só este lado define fields/references
  slotId Int?              @unique
  slot   ConsultationSlot? @relation("ConsultationSlotLink", fields: [slotId], references: [id])

  proposals ConsultationProposal[]
  events    ConsultationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([librarianId, startAt])
  @@index([familyId, startAt])
}

model ConsultationEvent {
  id             Int          @id @default(autoincrement())
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  consultationId Int

  type String
  at   DateTime @default(now())

  actor   User? @relation("ConsultationEventActor", fields: [actorId], references: [id])
  actorId Int?

  payload Json?
}

model ConsultationSlot {
  id Int @id @default(autoincrement())

  librarian   User @relation("LibrarianSlots", fields: [librarianId], references: [id])
  librarianId Int

  library   Library? @relation(fields: [libraryId], references: [id])
  libraryId Int?

  startAt DateTime
  endAt   DateTime
  status  SlotStatus @default(OPEN)

  // 👇 lado passivo da 1–1 (mesmo nome da relação do outro lado)
  consultation Consultation? @relation("ConsultationSlotLink")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([librarianId, startAt, endAt])
  @@index([librarianId, startAt, status])
}

model ConsultationProposal {
  id             Int          @id @default(autoincrement())
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  consultationId Int

  proposedBy  ProposalActor
  fromStartAt DateTime?
  fromEndAt   DateTime?
  toStartAt   DateTime
  toEndAt     DateTime

  message   String?
  status    ProposalStatus @default(PENDING)
  createdAt DateTime       @default(now())
  decidedAt DateTime?

  decidedBy   User? @relation("ProposalDecider", fields: [decidedById], references: [id])
  decidedById Int?

  @@index([consultationId, status])
}

// Eventos culturais (importados de RSS ou manualmente)
model CulturalEvent {
  id          Int       @id @default(autoincrement())
  feed        FeedRss?  @relation(fields: [feedId], references: [id])
  feedId      Int?
  guid        String    @unique
  title       String
  description String?
  pubDate     DateTime?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  category    String?
  capacity    Int?
  imageUrl    String?

  // 👇 NOVO: associação direta à biblioteca para eventos manuais
  library   Library? @relation(fields: [libraryId], references: [id])
  libraryId Int?

  reservations EventReservation[]

  @@index([libraryId, startDate])
}

// Reservas de eventos culturais
model EventReservation {
  id       Int           @id @default(autoincrement())
  family   User          @relation(fields: [familyId], references: [id])
  familyId Int
  event    CulturalEvent @relation(fields: [eventId], references: [id])
  eventId  Int
  bookedAt DateTime      @default(now())
  status   String // "PENDING" | "CONFIRMED"

  @@unique([familyId, eventId])
  @@index([eventId, status])
}

// Reservas de livros
model BookReservation {
  id         Int       @id @default(autoincrement())
  child      Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId    Int
  book       Book      @relation(fields: [bookIsbn], references: [isbn])
  bookIsbn   String
  reservedAt DateTime  @default(now())
  readings   Reading[]

  @@unique([childId, bookIsbn]) // 👈 APENAS UMA reserva por (criança, livro)
  @@index([childId, bookIsbn, reservedAt])
}

// Tabela de newsletters
model Newsletter {
  id          Int      @id @default(autoincrement()) // PK: id_newsletter
  title       String // título
  content     String // conteúdo
  publishedAt DateTime @default(now()) // data_publicacao
}

// Subscrições de newsletter por família
model NewsletterSubscription {
  id           Int      @id @default(autoincrement()) // PK: id_subscricao
  family       User     @relation(fields: [familyId], references: [id])
  familyId     Int // FK → User.id
  frequency    String // frequência (SEMANAL/MENSAL)
  subscribedAt DateTime @default(now()) // data_subscricao
  status       String // estado (ATIVA/INATIVA)
}

// Micro-conteúdos “Sabias que…”
model MicroContent {
  id           Int                @id @default(autoincrement()) // PK: id_micro
  text         String // texto do micro-conteúdo
  interactions MicroInteraction[] // relação 1:N → MicroInteraction
}

// Interações com micro-conteúdos
model MicroInteraction {
  id             Int          @id @default(autoincrement()) // PK: id_interacao
  user           User         @relation(fields: [userId], references: [id])
  userId         Int // FK → User.id
  microContent   MicroContent @relation(fields: [microContentId], references: [id])
  microContentId Int // FK → MicroContent.id
  interactedAt   DateTime     @default(now()) // data_interacao
}

// 👇 NOVO: holdings/exemplares por biblioteca
model LibraryBook {
  library   Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  libraryId Int

  book   Book   @relation(fields: [bookIsbn], references: [isbn], onDelete: Cascade)
  bookIsbn String

  quantity    Int?     // opcional: nº de exemplares
  shelfCode   String?  // cota / localização
  accessionNo String?  // nº de registo interno

  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([libraryId, bookIsbn])
  @@index([bookIsbn])
}
